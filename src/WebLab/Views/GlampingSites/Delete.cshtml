@model WebLab.Models.GlampingSite

@{
    ViewData["Title"] = "Видалення глемпінгу";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-danger border-2">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Підтвердження видалення</h4>
            </div>
            <div class="card-body p-4">
                <h5 class="text-danger mb-3">Ви дійсно бажаєте видалити цей глемпінг?</h5>
                
                <div class="card bg-light p-3 mb-4">
                    <h5 class="fw-bold text-dark">@Model.Name</h5>
                    <p class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>Регіон: @Model.Region?.Name</p>
                    <p class="text-muted mb-1"><i class="bi bi-pin-map me-1"></i>Адреса: @Model.Address</p>
                    <p class="text-muted mb-0"><i class="bi bi-cash me-1"></i>Ціна за добу: @Model.PricePerNight.ToString("N0") ₴</p>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Скасувати
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-1"></i>Так, видалити назавжди
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
