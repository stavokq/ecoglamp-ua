@model IEnumerable<WebLab.Models.GlampingSite>

@{
    ViewData["Title"] = "Інтерактивна мапа глемпінгів";
    var regions = ViewBag.Regions as IEnumerable<WebLab.Models.Region> ?? Enumerable.Empty<WebLab.Models.Region>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-map text-success me-2"></i>Інтерактивна мапа еко-глемпінгів України
        </h1>
        <p class="text-muted mb-0">Досліджуйте локації на мапі, переглядайте ціни та обирайте відпочинок</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-grid me-1"></i>Каталог плиткою
        </a>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i>Додати глемпінг
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3 bg-white">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="mapSearchInput" class="form-control border-start-0" 
                           placeholder="Швидкий пошук глемпінгу на карті..." />
                </div>
            </div>
            <div class="col-md-4">
                <select id="mapRegionFilter" class="form-select">
                    <option value="">-- Всі природні регіони --</option>
                    @foreach (var r in regions)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="button" id="resetMapBtn" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrows-fullscreen me-1"></i>Вся Україна
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 overflow-hidden">
            <div id="glampingMap" style="height: 650px; width: 100%; z-index: 1;"></div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>Локації на мапі 
                    <span class="badge bg-success rounded-pill ms-1" id="visibleCount">@Model.Count()</span>
                </h6>
                <small class="text-muted">Клікніть для перегляду</small>
            </div>
            <div class="card-body p-2 overflow-auto" style="max-height: 590px;" id="sidebarList">
                @foreach (var site in Model)
                {
                    var avgRating = site.Reviews.Any() ? site.Reviews.Average(r => r.Rating) : 0;
                    <div class="card glamping-list-card mb-2 border rounded shadow-sm" 
                         data-id="@site.Id" 
                         data-region-id="@site.RegionId" 
                         data-lat="@site.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                         data-lng="@site.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                         data-name="@site.Name.ToLower()" 
                         style="cursor: pointer; transition: transform 0.15s ease;">
                        <div class="row g-0 align-items-center">
                            <div class="col-4">
                                <img src="@(string.IsNullOrEmpty(site.ImageUrl) ? "https://images.unsplash.com/photo-1510312305653-8ed496efae75?w=500&q=80" : site.ImageUrl)" 
                                     class="img-fluid rounded-start w-100" style="height: 85px; object-fit: cover;" alt="@site.Name" />
                            </div>
                            <div class="col-8">
                                <div class="card-body py-2 px-3">
                                    <h6 class="card-title fw-bold text-dark text-truncate mb-1" style="font-size: 0.95rem;">@site.Name</h6>
                                    <div class="small text-muted mb-1 text-truncate">
                                        <i class="bi bi-geo-alt text-danger"></i> @(site.Region?.Name ?? "Україна")
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-success" style="font-size: 0.9rem;">@site.PricePerNight.ToString("N0") ₴ <span class="text-muted small fw-normal">/ доба</span></span>
                                        @if (avgRating > 0)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill text-danger"></i> @avgRating.ToString("0.0")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var sitesData = [
        @foreach (var site in Model)
        {
            var rating = site.Reviews.Any() ? site.Reviews.Average(r => r.Rating) : 0;
            <text>
            {
                id: @site.Id,
                name: "@Html.Raw(JavaScriptEncoder.Default.Encode(site.Name))",
                regionId: @site.RegionId,
                regionName: "@Html.Raw(JavaScriptEncoder.Default.Encode(site.Region?.Name ?? "Україна"))",
                address: "@Html.Raw(JavaScriptEncoder.Default.Encode(site.Address))",
                lat: @site.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture),
                lng: @site.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture),
                price: "@site.PricePerNight.ToString("N0")",
                guests: @site.MaxGuests,
                rating: "@(rating > 0 ? rating.ToString("0.0") : "Немає")",
                image: "@(string.IsNullOrEmpty(site.ImageUrl) ? "https://images.unsplash.com/photo-1510312305653-8ed496efae75?w=500&q=80" : site.ImageUrl)",
                detailsUrl: "/GlampingSites/Details/@site.Id"
            },
            </text>
        }
    ];

    var map = L.map('glampingMap').setView([48.5, 31.2], 6);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    var markersMap = {};
    var bounds = [];

    sitesData.forEach(function (site) {
        if (!site.lat || !site.lng) return;

        var popupContent = `
            <div style="width: 220px; font-family: sans-serif;">
                <img src="${site.image}" style="width: 100%; height: 110px; object-fit: cover; border-radius: 6px; margin-bottom: 8px;" alt="${site.name}" />
                <h6 style="margin: 0 0 4px 0; font-weight: bold; font-size: 14px;">${site.name}</h6>
                <div style="font-size: 12px; color: #6c757d; margin-bottom: 4px;">
                    <span>📍 ${site.regionName}</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <strong style="color: #198754; font-size: 14px;">${site.price} ₴ <small style="color: #6c757d; font-weight: normal;">/ ніч</small></strong>
                    <span style="background: #ffc107; color: #212529; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: bold;">⭐ ${site.rating}</span>
                </div>
                <a href="${site.detailsUrl}" class="btn btn-sm btn-success w-100 text-white" style="text-decoration: none; display: block; text-align: center; padding: 4px; border-radius: 4px; font-size: 12px;">
                    Детальніше & Бронювання
                </a>
            </div>
        `;

        var marker = L.marker([site.lat, site.lng]).addTo(map).bindPopup(popupContent);
        markersMap[site.id] = marker;
        bounds.push([site.lat, site.lng]);
    });

    if (bounds.length > 0) {
        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 11 });
    }

    $('.glamping-list-card').on('click', function () {
        var id = $(this).data('id');
        var lat = parseFloat($(this).data('lat'));
        var lng = parseFloat($(this).data('lng'));

        if (markersMap[id]) {
            map.flyTo([lat, lng], 13, { duration: 1.2 });
            markersMap[id].openPopup();
        }
    });

    $('.glamping-list-card').hover(
        function () { $(this).addClass('bg-light shadow').css('transform', 'translateY(-2px)'); },
        function () { $(this).removeClass('bg-light shadow').css('transform', 'translateY(0)'); }
    );

    function filterMap() {
        var selectedRegion = $('#mapRegionFilter').val();
        var searchVal = $('#mapSearchInput').val().trim().toLowerCase();
        var visibleCount = 0;
        var activeBounds = [];

        sitesData.forEach(function (site) {
            var matchRegion = !selectedRegion || site.regionId.toString() === selectedRegion;
            var matchSearch = !searchVal || site.name.toLowerCase().includes(searchVal) || site.address.toLowerCase().includes(searchVal);

            var card = $(`.glamping-list-card[data-id="${site.id}"]`);
            var marker = markersMap[site.id];

            if (matchRegion && matchSearch) {
                card.show();
                if (marker) {
                    if (!map.hasLayer(marker)) map.addLayer(marker);
                    activeBounds.push([site.lat, site.lng]);
                }
                visibleCount++;
            } else {
                card.hide();
                if (marker && map.hasLayer(marker)) {
                    map.removeLayer(marker);
                }
            }
        });

        $('#visibleCount').text(visibleCount);

        if (activeBounds.length > 0) {
            map.fitBounds(activeBounds, { padding: [50, 50], maxZoom: 11 });
        }
    }

    $('#mapRegionFilter').on('change', filterMap);
    $('#mapSearchInput').on('input', filterMap);

    $('#resetMapBtn').on('click', function () {
        $('#mapRegionFilter').val('');
        $('#mapSearchInput').val('');
        filterMap();
        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [50, 50] });
        } else {
            map.setView([48.5, 31.2], 6);
        }
    });
</script>
}
