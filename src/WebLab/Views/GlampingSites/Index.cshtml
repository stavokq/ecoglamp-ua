@model IEnumerable<WebLab.Models.GlampingSite>

@{
    ViewData["Title"] = "Каталог глемпінгів";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-tree text-success me-2"></i>Каталог еко-глемпінгів України
        </h1>
        <p class="text-muted mb-0">Знайдіть найкраще місце для єднання з природою</p>
    </div>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Додати новий об'єкт
    </a>
</div>

<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" 
                           class="form-control border-start-0" placeholder="Пошук за назвою або адресою..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="regionId" asp-items="ViewBag.Regions" class="form-select">
                    <option value="">-- Всі природні регіони --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Фільтрувати
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-compass display-1 text-muted"></i>
            <h4 class="mt-3 text-secondary">Глемпінгів не знайдено</h4>
            <p class="text-muted">Спробуйте змінити фільтри або додати новий об'єкт.</p>
            <a asp-action="Create" class="btn btn-outline-success mt-2">Створити перший об'єкт</a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 overflow-hidden d-flex flex-column">
                    <div class="position-relative" style="height: 220px; background-color: #e9ecef;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.Name" 
                                 onerror="this.onerror=null; this.src='https://placehold.co/600x400/2d6a4f/ffffff?text=EcoGlamp';" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                        }
                        <span class="position-absolute top-0 start-0 m-2 badge bg-success shadow-sm">
                            <i class="bi bi-geo-alt me-1"></i>@item.Region?.Name
                        </span>
                        <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-75 shadow-sm">
                            @item.PricePerNight.ToString("N0") ₴ / ніч
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark mb-1">@item.Name</h5>
                        <p class="card-subtitle small text-muted mb-2">
                            <i class="bi bi-pin-map-fill text-danger me-1"></i>@item.Address
                        </p>
                        <p class="card-text text-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Description
                        </p>

                        <div class="mb-3">
                            @if (item.GlampingActivities.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var ga in item.GlampingActivities.Take(3))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi @ga.Activity?.IconClass me-1 text-success"></i>@ga.Activity?.Name
                                        </span>
                                    }
                                    @if (item.GlampingActivities.Count > 3)
                                    {
                                        <span class="badge bg-light text-muted border">+@(item.GlampingActivities.Count - 3)</span>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(item.DocumentUrl))
                        {
                            <div class="mb-3">
                                <a href="@item.DocumentUrl" target="_blank" class="badge bg-info bg-opacity-10 text-primary text-decoration-none border border-info border-opacity-25 p-2">
                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i>Правила проживання / Буклет
                                </a>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top">
                            <span><i class="bi bi-people me-1"></i>до @item.MaxGuests гостей</span>
                            <span><i class="bi bi-star-fill text-warning me-1"></i>@(item.Reviews.Any() ? item.Reviews.Average(r => r.Rating).ToString("F1") : "новий")</span>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                            <i class="bi bi-info-circle me-1"></i>Деталі
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Редагувати">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Видалити">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
