@model WebLab.Models.Region

@{
    ViewData["Title"] = "Видалити регіон";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger border-2">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Підтвердження видалення</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-bold">Ви впевнені, що бажаєте видалити цей регіон?</p>
                <div class="p-3 bg-light rounded mb-3">
                    <h5 class="fw-bold">@Model.Name</h5>
                    <p class="text-muted mb-0">@Model.Description</p>
                </div>

                @if (Model.GlampingSites.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle me-1"></i>У цьому регіоні є <strong>@Model.GlampingSites.Count</strong> об'єктів. Спочатку перенесіть або видаліть їх.
                    </div>
                }

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                        <button type="submit" class="btn btn-danger" @(Model.GlampingSites.Any() ? "disabled" : "")>
                            Видалити
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
