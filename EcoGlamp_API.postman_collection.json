	"item": [
		{
			"name": "01. GET Glamping Sites (Пагінація skip=0, limit=3)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус-код 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Формат відповіді валідний JSON з полями пагінації\", function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data).to.have.property(\"items\");",
							"    pm.expect(data).to.have.property(\"totalCount\");",
							"    pm.expect(data).to.have.property(\"skip\", 0);",
							"    pm.expect(data).to.have.property(\"limit\", 3);",
							"    pm.expect(data.items).to.be.an(\"array\");",
							"    pm.expect(data.items.length).to.be.at.most(3);",
							"});",
							"",
							"pm.test(\"Поле nextLink присутнє, якщо елементів більше ніж limit\", function () {",
							"    var data = pm.response.json();",
							"    if (data.totalCount > 3) {",
							"        pm.expect(data.nextLink).to.be.a(\"string\");",
							"        pm.expect(data.nextLink).to.include(\"skip=3\");",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/glampingsites?skip=0&limit=3",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"glampingsites"
					],
					"query": [
						{
							"key": "skip",
							"value": "0"
						},
						{
							"key": "limit",
							"value": "3"
						}
					]
				}
			}
		},
